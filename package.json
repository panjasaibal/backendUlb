{
  "name": "backenduluberia",
  "version": "1.1.0",
  "description": "Backend application for track workers",
  "main": "index.js",
  "scripts": {
    "start": "pm2 start ./build/src/app.js -i 5 --attach --watch",
    "stop": "pm2 stop all",
    "delete": "pm2 delete all",
    "dev": "nodemon -r tsconfig-paths/register src/app.ts",
    "build": "tsc --project tsconfig.json && tsc-alias -p tsconfig.json && ts-node tools/copyAssets.ts",
    "lint:check": "eslint src/**/*.ts",
    "lint:fix": "eslint 'src/**/*.ts' --fix",
    "prettier:check": "prettier --check src/**/*.ts",
    "prettier:fix": "prettier --write src/**/*.ts",
    "test": "jest --coverage=true -w=1 --forceExit --detectOpenHandles --watchAll=false"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@panjasaibal/backend_ulb_shared": "^1.0.0",
    "bcrypt": "^6.0.0",
    "cloudinary": "^2.2.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "express-validator": "^7.0.1",
    "helmet": "^8.1.0",
    "hpp": "^0.2.3",
    "http-status-codes": "^2.3.0",
    "joi": "^18.0.2",
    "mongodb": "^6.4.0",
    "mongoose": "^7.1.1",
    "multer": "^1.4.5-lts.1",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/hpp": "^0.2.7",
    "@types/passport": "^1.0.17",
    "@types/passport-google-oauth20": "^2.0.17"
  }
}
